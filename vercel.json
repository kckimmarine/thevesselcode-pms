{
  "version": 2,
  "framework": null,
  "installCommand": "npm install --omit=dev --ignore-scripts",
  "buildCommand": "node scripts/vercel-static-build.mjs",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/home/", "destination": "/", "permanent": true },
    { "source": "/about-contact", "destination": "/contact-us", "permanent": true },
    { "source": "/about-contact/", "destination": "/contact-us", "permanent": true },
    { "source": "/contact", "destination": "/contact-us", "permanent": true },
    { "source": "/contact/", "destination": "/contact-us", "permanent": true },
    { "source": "/store-public.html", "destination": "/toolkit", "permanent": true },
    { "source": "/store-public", "destination": "/toolkit", "permanent": true },
    { "source": "/maritime-toolkit", "destination": "/toolkit", "permanent": true },
    { "source": "/maritime-toolkit/", "destination": "/toolkit", "permanent": true },
    { "source": "/impa", "destination": "/toolkit", "permanent": true },
    { "source": "/impa/", "destination": "/toolkit", "permanent": true },
    { "source": "/maritime-pms", "destination": "https://app.thevesselcode.com", "permanent": false },
    { "source": "/maritime-pms/", "destination": "https://app.thevesselcode.com", "permanent": false },
    { "source": "/pms", "destination": "https://app.thevesselcode.com", "permanent": false },
    { "source": "/pms/", "destination": "https://app.thevesselcode.com", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "app.thevesselcode.com" }],
      "destination": "/app.html"
    },
    { "source": "/services", "destination": "/services/index.html" },
    { "source": "/contact-us", "destination": "/contact-us/index.html" },
    { "source": "/toolkit", "destination": "/toolkit.html" },
    { "source": "/store/:code", "destination": "/api/store/:code" },
    {
      "source": "/((?!vendor|js|css|icons|data|public|admin|downloads|bluehost|api|manifest.json|service-worker.js|package.json|app.html|toolkit.html|store-public.html|about-contact|home|services|contact-us|store|sitemap|robots\\.txt).+)",
      "has": [{ "type": "host", "value": "app.thevesselcode.com" }],
      "destination": "/app.html"
    }
  ],
  "functions": {
    "api/store/[code].js": {
      "includeFiles": "api/_data/impa-seo-index.json"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://thevesselcode.com https://www.thevesselcode.com https://*.thevesselcode.com"
        }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/app.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/toolkit.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
