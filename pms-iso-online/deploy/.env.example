# Supabase — PERFECT MARINE SOLUTION ISO (전용 프로젝트)
# TVC-PMS 프로덕션과 분리된 새 프로젝트를 만든 뒤 아래 값을 채웁니다.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret

# Database → Connection string → URI (Session pooler 또는 Direct)
# 비밀번호에 @ 등 특수문자는 URL 인코딩
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# setup:apply 시 첫 관리자 자동 생성 (선택)
PMS_ISO_ADMIN_EMAIL=quality@yourcompany.com
PMS_ISO_ADMIN_PASSWORD=change-me-strong-password
