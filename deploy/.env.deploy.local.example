# Copy to deploy/.env.deploy.local (gitignored) — INCHEON CHEMI pilot only
#
# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
#
# Supabase → Project Settings → Database → Connection string (URI, percent-encode special chars in password)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
#
# Vercel → Account Settings → Tokens
VERCEL_TOKEN=your_vercel_token
# Vercel project → Settings → General → Project ID
VERCEL_PROJECT_ID=prj_xxxxxxxx
# Optional team
# VERCEL_TEAM_ID=team_xxxxxxxx
#
# Optional: auto redeploy from GitHub after env set
# VERCEL_GIT_REPO=kckimmarine/thevesselcode-pms
# VERCEL_GIT_REF=master
#
SYNC_PILOT_VESSEL_ID=INCHEON CHEMI
